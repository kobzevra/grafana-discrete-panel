{
  "name": "kobzevra-production-timeline-panel",
  "version": "0.1.0",
  "description": "Boundary-safe production job and machine-state timeline panel for Grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "test:runtime": "playwright test tests/runtime-smoke.spec.ts --config playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "react:detect": "npx -y @grafana/react-detect@latest"
  },
  "author": "kobzevra; derived from NatelEnergy/grafana-discrete-panel",
  "license": "MIT",
  "keywords": ["grafana", "panel", "timeline", "production", "discrete", "intervals"],
  "repository": { "type": "git", "url": "https://github.com/kobzevra/grafana-discrete-panel.git" },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@grafana/data": "13.1.1",
    "@grafana/i18n": "13.1.1",
    "@grafana/runtime": "13.1.1",
    "@grafana/schema": "13.1.1",
    "@grafana/ui": "13.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.10.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "1.62.1",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.32.0",
    "eslint-webpack-plugin": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  }
}
